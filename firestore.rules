rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esPropietario(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function esAdministradorActivo() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.rol == 'ADM'
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.estado == 'ACTIVO';
    }

    function esDtConCuentaHabilitada() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'DT'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.estado
          in ['ACTIVO', 'PENDIENTE_VINCULACION'];
    }

    // Permite descubrir exclusivamente los vínculos propios del DT o del jugador.
    // La consulta debe filtrar uid == request.auth.uid.
    match /{ruta=**}/miembros/{miembroId} {
      allow list: if (esDtConCuentaHabilitada() || esJugadorConCuentaHabilitada())
        && resource.data.uid == request.auth.uid;
    }

    function esJugadorConCuentaHabilitada() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'JUG'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.estado
          in ['ACTIVO', 'PENDIENTE_VINCULACION'];
    }

    // Descubrimiento de asignaciones propias, incluido el registro de retiros.
    // No autoriza consultar documentos de otros jugadores ni modificarlos.
    match /{ruta=**}/plantel/{jugadorId} {
      allow list: if esJugadorConCuentaHabilitada()
        && resource.data.jugadorUid == request.auth.uid;
    }

    match /academias/{academiaId} {

      function administraAcademia() {
        return esAdministradorActivo()
          && get(
            /databases/$(database)/documents/academias/$(academiaId)
          ).data.creadoPor == request.auth.uid;
      }

      function esJugadorMiembroActivo() {
        return esJugadorConCuentaHabilitada()
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.academiaId == academiaId
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.rol == 'JUG'
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.activo == true;
      }

      function academiaActiva() {
        return get(
          /databases/$(database)/documents/academias/$(academiaId)
        ).data.activa == true;
      }

      function nombreAcademiaValido() {
        return request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2
          && request.resource.data.nombre.size() <= 100;
      }

      function nombreEquipoCorrecto(nombre) {
        return nombre is string
          && nombre.size() >= 2
          && nombre.size() <= 60
          && nombre.matches("^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9 .'-]+$")
          && nombre == nombre.trim().replace(' +', ' ');
      }

      function claveNombreEquipo(datos) {
        return datos.categoriaId + '_' + datos.nombre.lower();
      }

      function reservaCorresponde(datos, equipoId) {
        let clave = claveNombreEquipo(datos);

        return getAfter(
          /databases/$(database)/documents/academias/$(academiaId)/nombresEquipos/$(clave)
        ).data.equipoId == equipoId;
      }

      function nombreAnteriorLiberado(antes, despues) {
        let claveAnterior = claveNombreEquipo(antes);
        let claveNueva = claveNombreEquipo(despues);

        return claveAnterior == claveNueva
          || !existsAfter(
            /databases/$(database)/documents/academias/$(academiaId)/nombresEquipos/$(claveAnterior)
          );
      }

      function esDtMiembroActivo() {
        return esDtConCuentaHabilitada()
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.academiaId == academiaId
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.rol == 'DT'
          && get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(request.auth.uid)).data.activo == true;
      }

      // Puede leer el nombre y estado de su academia, pero no listar otras.
      allow get: if esDtMiembroActivo() || esJugadorMiembroActivo();

      // ACADEMIAS

      allow get, list: if esAdministradorActivo()
        && resource.data.creadoPor == request.auth.uid;

      allow create: if esAdministradorActivo()
        && request.resource.data.keys().hasAll([
          'nombre',
          'activa',
          'creadoPor',
          'actualizadoPor',
          'fechaCreacion',
          'fechaActualizacion'
        ])
        && request.resource.data.keys().hasOnly([
          'nombre',
          'activa',
          'creadoPor',
          'actualizadoPor',
          'fechaCreacion',
          'fechaActualizacion'
        ])
        && nombreAcademiaValido()
        && request.resource.data.activa == true
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.fechaActualizacion == request.time;

      allow update: if esAdministradorActivo()
        && resource.data.creadoPor == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'nombre',
              'activa',
              'actualizadoPor',
              'fechaActualizacion'
            ])
        && nombreAcademiaValido()
        && request.resource.data.activa is bool
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.fechaActualizacion == request.time;

      allow delete: if false;

      // SOLICITUDES DE VINCULACIÓN DE DT Y JUGADORES
      match /solicitudesVinculacion/{solicitanteUid} {
        function esSolicitanteHabilitado() {
          return esPropietario(solicitanteUid)
            && get(/databases/$(database)/documents/users/$(solicitanteUid)).data.rol in ['DT', 'JUG']
            && get(/databases/$(database)/documents/users/$(solicitanteUid)).data.estado
              in ['PENDIENTE_VINCULACION', 'ACTIVO'];
        }

        // También permite consultar un documento propio aún inexistente,
        // necesario para comprobar duplicados antes de crear la solicitud.
        allow get: if esSolicitanteHabilitado() || administraAcademia();
        allow list: if administraAcademia();

        allow create: if esSolicitanteHabilitado()
          && academiaActiva()
          && request.resource.data.keys().hasAll([
            'academiaId', 'solicitanteUid', 'nombreSolicitante',
            'estado', 'fechaCreacion', 'rolSolicitante'
          ])
          && request.resource.data.keys().hasOnly([
            'academiaId', 'solicitanteUid', 'nombreSolicitante',
            'estado', 'fechaCreacion', 'rolSolicitante'
          ])
          && request.resource.data.academiaId == academiaId
          && request.resource.data.solicitanteUid == solicitanteUid
          && request.resource.data.rolSolicitante in ['DT', 'JUG']
          && request.resource.data.rolSolicitante ==
            get(/databases/$(database)/documents/users/$(solicitanteUid)).data.rol
          && request.resource.data.nombreSolicitante is string
          && request.resource.data.nombreSolicitante.size() >= 2
          && request.resource.data.nombreSolicitante.size() <= 100
          && request.resource.data.nombreSolicitante ==
            get(/databases/$(database)/documents/users/$(solicitanteUid)).data.nombre
          && request.resource.data.estado == 'PENDIENTE'
          && request.resource.data.fechaCreacion == request.time;

        function perfilSolicitanteVigente() {
          let perfil = get(/databases/$(database)/documents/users/$(solicitanteUid)).data;
          return perfil.uid == solicitanteUid
            && perfil.rol in ['DT', 'JUG']
            && perfil.rol == resource.data.get('rolSolicitante', 'DT')
            && perfil.estado in ['PENDIENTE_VINCULACION', 'ACTIVO'];
        }

        function creaVinculoAlAprobar() {
          let ruta = /databases/$(database)/documents/academias/$(academiaId)/miembros/$(solicitanteUid);
          let vinculo = getAfter(ruta).data;
          return !exists(ruta)
            && vinculo.uid == solicitanteUid
            && vinculo.academiaId == academiaId
            && vinculo.rol == resource.data.get('rolSolicitante', 'DT')
            && vinculo.activo == true
            && vinculo.creadoPor == request.auth.uid
            && vinculo.fechaCreacion == request.time;
        }

        allow update: if administraAcademia()
          && academiaActiva()
          && resource.data.estado == 'PENDIENTE'
          && resource.data.academiaId == academiaId
          && resource.data.solicitanteUid == solicitanteUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'revisadoPor', 'fechaRevision'])
          && request.resource.data.revisadoPor == request.auth.uid
          && request.resource.data.fechaRevision == request.time
          && (
            request.resource.data.estado == 'RECHAZADA'
            || (request.resource.data.estado == 'APROBADA'
              && perfilSolicitanteVigente() && creaVinculoAlAprobar())
          );
        allow delete: if false;
      }

      // VÍNCULOS CON LA ACADEMIA: solo se crean al aprobar una solicitud.
      match /miembros/{miembroUid} {
        function aprobacionSimultanea() {
          let ruta = /databases/$(database)/documents/academias/$(academiaId)/solicitudesVinculacion/$(miembroUid);
          let antes = get(ruta).data;
          let despues = getAfter(ruta).data;
          return antes.estado == 'PENDIENTE'
            && antes.solicitanteUid == miembroUid
            && antes.academiaId == academiaId
            && antes.get('rolSolicitante', 'DT') in ['DT', 'JUG']
            && request.resource.data.rol == antes.get('rolSolicitante', 'DT')
            && despues.get('rolSolicitante', 'DT') == antes.get('rolSolicitante', 'DT')
            && despues.solicitanteUid == miembroUid
            && despues.academiaId == academiaId
            && despues.estado == 'APROBADA'
            && despues.revisadoPor == request.auth.uid
            && despues.fechaRevision == request.time;
        }

        allow get: if esPropietario(miembroUid) || administraAcademia();
        allow list: if administraAcademia();
        allow create: if administraAcademia() && academiaActiva()
          && request.resource.data.keys().hasAll([
            'uid', 'academiaId', 'rol', 'activo', 'creadoPor', 'fechaCreacion'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'academiaId', 'rol', 'activo', 'creadoPor', 'fechaCreacion'
          ])
          && request.resource.data.uid == miembroUid
          && request.resource.data.academiaId == academiaId
          && request.resource.data.rol in ['DT', 'JUG']
          && request.resource.data.activo == true
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.fechaCreacion == request.time
          && aprobacionSimultanea();
        allow update, delete: if false;
      }

      // CATEGORÍAS

      match /categorias/{categoriaId} {
        allow get: if (esDtMiembroActivo() || esJugadorMiembroActivo()) && academiaActiva();

        function nombreCategoriaValido() {
          return request.resource.data.nombre is string
            && request.resource.data.nombre.size() >= 2
            && request.resource.data.nombre.size() <= 60;
        }

        allow get, list: if administraAcademia();

        allow create: if administraAcademia()
          && academiaActiva()
          && request.resource.data.keys().hasAll([
            'academiaId',
            'nombre',
            'activa',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion'
          ])
          && request.resource.data.keys().hasOnly([
            'academiaId',
            'nombre',
            'activa',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion'
          ])
          && request.resource.data.academiaId == academiaId
          && nombreCategoriaValido()
          && request.resource.data.activa == true
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaCreacion == request.time
          && request.resource.data.fechaActualizacion == request.time;

        allow update: if administraAcademia()
          && academiaActiva()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'nombre',
                'activa',
                'actualizadoPor',
                'fechaActualizacion'
              ])
          && nombreCategoriaValido()
          && request.resource.data.activa is bool
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaActualizacion == request.time;

        allow delete: if false;
      }

      // EQUIPOS

      match /equipos/{equipoId} {
        function perteneceAlPlantel() {
          let asignacion = get(/databases/$(database)/documents/academias/$(academiaId)/equipos/$(equipoId)/plantel/$(request.auth.uid)).data;
          return asignacion.jugadorUid == request.auth.uid
            && asignacion.academiaId == academiaId && asignacion.equipoId == equipoId
            && asignacion.activo == true;
        }
        allow get: if esJugadorMiembroActivo() && academiaActiva()
          && perteneceAlPlantel();

        // Plantel: solo datos mínimos, sin acceso al perfil deportivo privado.
        match /plantel/{jugadorUid} {
          function equipoDelPlantel() {
            return get(/databases/$(database)/documents/academias/$(academiaId)/equipos/$(equipoId)).data;
          }
          function puedeLeerPlantel() {
            return administraAcademia() ||
              (esDtMiembroActivo() && academiaActiva()
                && equipoDelPlantel().academiaId == academiaId
                && equipoDelPlantel().dtUid == request.auth.uid);
          }
          function jugadorAprobado() {
            let miembro = get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(jugadorUid)).data;
            let solicitud = get(/databases/$(database)/documents/academias/$(academiaId)/solicitudesVinculacion/$(jugadorUid)).data;
            let cuenta = get(/databases/$(database)/documents/users/$(jugadorUid)).data;
            return miembro.uid == jugadorUid && miembro.academiaId == academiaId
              && miembro.rol == 'JUG' && miembro.activo == true
              && solicitud.solicitanteUid == jugadorUid && solicitud.academiaId == academiaId
              && solicitud.rolSolicitante == 'JUG' && solicitud.estado == 'APROBADA'
              && cuenta.uid == jugadorUid && cuenta.rol == 'JUG'
              && cuenta.estado in ['ACTIVO', 'PENDIENTE_VINCULACION'];
          }
          function datosPlantelValidos() {
            let d = request.resource.data;
            let campos = ['jugadorUid', 'academiaId', 'equipoId', 'nombre', 'activo',
              'agregadoPor', 'actualizadoPor', 'fechaCreacion', 'fechaActualizacion'];
            return d.keys().hasAll(campos) && d.keys().hasOnly(campos)
              && d.jugadorUid == jugadorUid && d.academiaId == academiaId
              && d.equipoId == equipoId
              && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 100
              && d.activo is bool && d.agregadoPor is string
              && d.actualizadoPor == request.auth.uid
              && d.fechaCreacion is timestamp && d.fechaActualizacion == request.time;
          }
          allow get, list: if puedeLeerPlantel();
          allow create: if administraAcademia() && academiaActiva()
            && equipoDelPlantel().academiaId == academiaId
            && equipoDelPlantel().activo == true
            && jugadorAprobado() && datosPlantelValidos()
            && request.resource.data.activo == true
            && request.resource.data.agregadoPor == request.auth.uid
            && request.resource.data.fechaCreacion == request.time
            && request.resource.data.nombre ==
              get(/databases/$(database)/documents/academias/$(academiaId)/solicitudesVinculacion/$(jugadorUid)).data.nombreSolicitante;
          allow update: if administraAcademia() && academiaActiva()
            && equipoDelPlantel().academiaId == academiaId
            && resource.data.jugadorUid == jugadorUid
            && resource.data.academiaId == academiaId && resource.data.equipoId == equipoId
            && datosPlantelValidos()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['activo', 'actualizadoPor', 'fechaActualizacion'])
            && (request.resource.data.activo == false ||
              (equipoDelPlantel().activo == true && jugadorAprobado()));
          allow delete: if false;
        }

        allow get, list: if esDtMiembroActivo() && academiaActiva()
          && resource.data.dtUid == request.auth.uid;

        function categoriaHabilitada() {
          let categoriaId = request.resource.data.categoriaId;

          return categoriaId is string
            && categoriaId.matches('^[A-Za-z0-9_-]{1,128}$')
            && get(
              /databases/$(database)/documents/academias/$(academiaId)/categorias/$(categoriaId)
            ).data.activa == true;
        }

        function solicitudValida() {
          let solicitud = request.resource.data.solicitudId;

          return solicitud is string
            && solicitud.matches(
              '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$'
            );
        }

        allow get, list: if administraAcademia();

        allow create: if administraAcademia()
          && academiaActiva()
          && request.resource.data.keys().hasAll([
            'academiaId',
            'categoriaId',
            'nombre',
            'activo',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion',
            'solicitudId'
          ])
          && request.resource.data.keys().hasOnly([
            'academiaId',
            'categoriaId',
            'nombre',
            'activo',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion',
            'solicitudId'
          ])
          && request.resource.data.academiaId == academiaId
          && categoriaHabilitada()
          && nombreEquipoCorrecto(request.resource.data.nombre)
          && solicitudValida()
          && equipoId == request.resource.data.solicitudId
          && request.resource.data.activo == true
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaCreacion == request.time
          && request.resource.data.fechaActualizacion == request.time
          && reservaCorresponde(request.resource.data, equipoId);

        allow update: if administraAcademia()
          && academiaActiva()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'nombre',
                'activo',
                'actualizadoPor',
                'fechaActualizacion'
              ])
          && nombreEquipoCorrecto(request.resource.data.nombre)
          && request.resource.data.activo is bool
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaActualizacion == request.time
          && (
            request.resource.data.nombre == resource.data.nombre
            || (
              reservaCorresponde(request.resource.data, equipoId)
              && nombreAnteriorLiberado(
                resource.data,
                request.resource.data
              )
            )
          );

        // Cambiar el entrenador no permite editar otros datos del equipo.
        function entrenadorAprobado(dtUid) {
          let miembro = get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(dtUid)).data;
          let solicitud = get(/databases/$(database)/documents/academias/$(academiaId)/solicitudesVinculacion/$(dtUid)).data;
          let perfil = get(/databases/$(database)/documents/users/$(dtUid)).data;
          return miembro.uid == dtUid && miembro.academiaId == academiaId
            && miembro.rol == 'DT' && miembro.activo == true
            && solicitud.estado == 'APROBADA'
            && solicitud.solicitanteUid == dtUid && solicitud.academiaId == academiaId
            && perfil.rol == 'DT'
            && perfil.estado in ['PENDIENTE_VINCULACION', 'ACTIVO'];
        }

        allow update: if administraAcademia() && academiaActiva()
          && resource.data.academiaId == academiaId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['dtUid', 'actualizadoPor', 'fechaActualizacion'])
          && request.resource.data.keys().hasAll(['dtUid'])
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaActualizacion == request.time
          && (
            request.resource.data.dtUid == null
            || (
              request.resource.data.dtUid is string
              && request.resource.data.dtUid.size() > 0
              && request.resource.data.dtUid.size() <= 128
              && request.resource.data.dtUid.matches('^[^/]+$')
              && resource.data.activo == true
              && entrenadorAprobado(request.resource.data.dtUid)
            )
          );

        allow delete: if false;
      }

      // RESERVAS DE NOMBRES DE EQUIPOS

      match /nombresEquipos/{clave} {

        function equipoDestinoValido() {
          let equipoId = request.resource.data.equipoId;
          let equipo = getAfter(
            /databases/$(database)/documents/academias/$(academiaId)/equipos/$(equipoId)
          ).data;

          return equipo.academiaId == academiaId
            && nombreEquipoCorrecto(equipo.nombre)
            && claveNombreEquipo(equipo) == clave;
        }

        // Evita duplicados con equipos del sistema anterior.
        function sinConflictoAnterior() {
          let equipoId = request.resource.data.equipoId;
          let rutaAnterior =
            /databases/$(database)/documents/academias/$(academiaId)/equipos/$(clave);

          return clave == equipoId
            || !existsAfter(rutaAnterior)
            || claveNombreEquipo(
              getAfter(rutaAnterior).data
            ) != clave;
        }

        function seLiberaAlRenombrar() {
          let equipoId = resource.data.equipoId;
          let rutaEquipo =
            /databases/$(database)/documents/academias/$(academiaId)/equipos/$(equipoId);

          return claveNombreEquipo(get(rutaEquipo).data) == clave
            && claveNombreEquipo(getAfter(rutaEquipo).data) != clave;
        }

        allow get: if administraAcademia();

        allow create: if administraAcademia()
          && academiaActiva()
          && request.resource.data.keys().hasAll(['equipoId'])
          && request.resource.data.keys().hasOnly(['equipoId'])
          && request.resource.data.equipoId is string
          && request.resource.data.equipoId.size() > 0
          && request.resource.data.equipoId.size() <= 200
          && request.resource.data.equipoId.matches('^[^/]+$')
          && equipoDestinoValido()
          && sinConflictoAnterior();

        allow delete: if administraAcademia()
          && academiaActiva()
          && seLiberaAlRenombrar();

        allow list, update: if false;
      }

      // PARTIDOS: los programa el administrador o el DT del equipo.
      match /partidos/{partidoId} {
        function equipoDelPartido(equipoId) {
          return get(/databases/$(database)/documents/academias/$(academiaId)/equipos/$(equipoId)).data;
        }
        function esDtDelEquipo(equipoId) {
          return esDtMiembroActivo()
            && equipoDelPartido(equipoId).dtUid == request.auth.uid;
        }
        function juegaEnEquipo(equipoId) {
          let asignacion = get(/databases/$(database)/documents/academias/$(academiaId)/equipos/$(equipoId)/plantel/$(request.auth.uid)).data;
          return esJugadorMiembroActivo()
            && asignacion.jugadorUid == request.auth.uid
            && asignacion.activo == true;
        }
        function gestionaEquipo(equipoId) {
          return administraAcademia() || esDtDelEquipo(equipoId);
        }
        function golesValidos(valor) {
          return valor is int && valor >= 0 && valor <= 99;
        }
        function datosPartidoValidos() {
          let d = request.resource.data;
          let campos = ['academiaId', 'equipoId', 'nombreEquipo', 'rival', 'lugar',
            'fechaHora', 'condicion', 'estado', 'golesFavor', 'golesContra',
            'creadoPor', 'actualizadoPor', 'fechaCreacion', 'fechaActualizacion'];
          return d.keys().hasAll(campos) && d.keys().hasOnly(campos)
            && d.academiaId == academiaId
            && d.rival is string && d.rival.size() >= 2 && d.rival.size() <= 60
            && d.lugar is string && d.lugar.size() >= 2 && d.lugar.size() <= 100
            && d.fechaHora is timestamp
            && d.condicion in ['LOCAL', 'VISITA']
            && d.estado in ['PROGRAMADO', 'FINALIZADO', 'CANCELADO']
            && ((d.estado == 'FINALIZADO' && golesValidos(d.golesFavor) && golesValidos(d.golesContra))
              || (d.estado != 'FINALIZADO' && d.golesFavor == null && d.golesContra == null))
            && d.actualizadoPor == request.auth.uid
            && d.fechaActualizacion == request.time;
        }

        // Las consultas de DT y jugadores deben filtrar equipoId.
        allow get, list: if administraAcademia()
          || (academiaActiva()
            && (esDtDelEquipo(resource.data.equipoId) || juegaEnEquipo(resource.data.equipoId)));

        allow create: if academiaActiva()
          && gestionaEquipo(request.resource.data.equipoId)
          && datosPartidoValidos()
          && equipoDelPartido(request.resource.data.equipoId).academiaId == academiaId
          && equipoDelPartido(request.resource.data.equipoId).activo == true
          && request.resource.data.nombreEquipo == equipoDelPartido(request.resource.data.equipoId).nombre
          && request.resource.data.estado == 'PROGRAMADO'
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.fechaCreacion == request.time;

        allow update: if academiaActiva()
          && gestionaEquipo(resource.data.equipoId)
          && datosPartidoValidos()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rival', 'lugar', 'fechaHora', 'condicion', 'estado',
            'golesFavor', 'golesContra', 'actualizadoPor', 'fechaActualizacion'
          ]);

        allow delete: if false;
      }
    }

    // PERFILES DE USUARIOS

    match /users/{uid} {

      allow get: if esPropietario(uid);

      allow create: if esPropietario(uid)
        && request.resource.data.keys().hasAll([
          'uid',
          'nombre',
          'correo',
          'rol',
          'fechaNacimiento',
          'edadVerificada',
          'estado',
          'fechaCreacion',
          'aceptoTerminos'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'nombre',
          'correo',
          'rol',
          'fechaNacimiento',
          'edadVerificada',
          'estado',
          'fechaCreacion',
          'aceptoTerminos'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.rol in ['JUG', 'PAD', 'DT']
        && request.resource.data.fechaNacimiento is string
        && request.resource.data.fechaNacimiento.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.edadVerificada == false
        && request.resource.data.estado == 'PENDIENTE_VINCULACION'
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.aceptoTerminos == true;

      allow update: if esPropietario(uid)
        && resource.data.estado == 'PENDIENTE_VINCULACION'
        && !('fechaNacimiento' in resource.data)
        && resource.data.get('edadVerificada', false) == false
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'fechaNacimiento',
              'edadVerificada'
            ])
        && request.resource.data.keys().hasAll([
          'fechaNacimiento',
          'edadVerificada'
        ])
        && request.resource.data.fechaNacimiento is string
        && request.resource.data.fechaNacimiento.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.edadVerificada == false;

      // La cuenta pasa a ACTIVO cuando su titular demuestra un vínculo aprobado:
      // academia con miembro activo (JUG/DT) o solicitud aprobada (PAD).
      function vinculoDeActivacionValido() {
        let referencia = request.resource.data.vinculoActivacion;
        return referencia is string
          && referencia.matches('^[A-Za-z0-9_-]{1,128}$')
          && ((resource.data.rol in ['JUG', 'DT']
              && get(/databases/$(database)/documents/academias/$(referencia)).data.activa == true
              && get(/databases/$(database)/documents/academias/$(referencia)/miembros/$(uid)).data.uid == uid
              && get(/databases/$(database)/documents/academias/$(referencia)/miembros/$(uid)).data.rol == resource.data.rol
              && get(/databases/$(database)/documents/academias/$(referencia)/miembros/$(uid)).data.activo == true)
            || (resource.data.rol == 'PAD'
              && get(/databases/$(database)/documents/solicitudesApoderado/$(referencia)).data.apoderadoUid == uid
              && get(/databases/$(database)/documents/solicitudesApoderado/$(referencia)).data.estado == 'APROBADA'));
      }

      allow update: if esPropietario(uid)
        && resource.data.estado == 'PENDIENTE_VINCULACION'
        && 'fechaNacimiento' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'vinculoActivacion'])
        && request.resource.data.estado == 'ACTIVO'
        && vinculoDeActivacionValido();

      allow list, delete: if false;
    }

    // Perfil deportivo privado. PAD, DT y ADM no tienen acceso en esta etapa.
    match /perfilesJugadores/{uid} {
      function jugadorPropietarioHabilitado() {
        return esPropietario(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == uid
          && get(/databases/$(database)/documents/users/$(uid)).data.rol == 'JUG'
          && get(/databases/$(database)/documents/users/$(uid)).data.estado
            in ['ACTIVO', 'PENDIENTE_VINCULACION'];
      }

      function telefonoValido(valor) {
        return valor is string
          && (valor == '' || valor.matches('^[+]?[0-9]{7,15}$'));
      }

      function perfilDeportivoValido() {
        let d = request.resource.data;
        let campos = ['uid', 'posicion', 'alturaCm', 'pesoKg', 'fotoPath',
          'telefonoContacto', 'nombreContactoEmergencia',
          'telefonoContactoEmergencia', 'actualizadoPor',
          'fechaCreacion', 'fechaActualizacion'];
        return d.keys().hasAll(campos) && d.keys().hasOnly(campos)
          && d.uid == uid
          && (d.posicion == null || d.posicion in
            ['PORTERO', 'DEFENSA', 'MEDIOCAMPISTA', 'DELANTERO'])
          && (d.alturaCm == null ||
            (d.alturaCm is int && d.alturaCm >= 50 && d.alturaCm <= 250))
          && (d.pesoKg == null ||
            (d.pesoKg is number && d.pesoKg >= 10 && d.pesoKg <= 300))
          && d.fotoPath == null
          && telefonoValido(d.telefonoContacto)
          && telefonoValido(d.telefonoContactoEmergencia)
          && d.nombreContactoEmergencia is string
          && (d.nombreContactoEmergencia == '' ||
            (d.nombreContactoEmergencia.size() >= 2 &&
             d.nombreContactoEmergencia.size() <= 100))
          && d.nombreContactoEmergencia == d.nombreContactoEmergencia.trim()
          && ((d.nombreContactoEmergencia == '' && d.telefonoContactoEmergencia == '') ||
              (d.nombreContactoEmergencia != '' && d.telefonoContactoEmergencia != ''))
          && d.actualizadoPor == request.auth.uid
          && d.fechaCreacion is timestamp
          && d.fechaActualizacion == request.time;
      }

      allow get: if jugadorPropietarioHabilitado();
      allow create: if jugadorPropietarioHabilitado()
        && perfilDeportivoValido()
        && request.resource.data.fechaCreacion == request.time;
      allow update: if jugadorPropietarioHabilitado()
        && resource.data.uid == uid
        && perfilDeportivoValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'posicion', 'alturaCm', 'pesoKg', 'telefonoContacto',
          'nombreContactoEmergencia', 'telefonoContactoEmergencia',
          'actualizadoPor', 'fechaActualizacion'
        ]);
      allow list, delete: if false;
    }

    // Invitaciones privadas: no conceden acceso a perfiles ni crean vínculos aprobados.
    function cuentaHabilitadaConRol(uid, rol) {
      let cuenta = get(/databases/$(database)/documents/users/$(uid)).data;
      return cuenta.uid == uid && cuenta.rol == rol
        && cuenta.estado in ['ACTIVO', 'PENDIENTE_VINCULACION'];
    }

    function administraAcademiaDeInvitacion(academiaId) {
      return esAdministradorActivo()
        && get(/databases/$(database)/documents/academias/$(academiaId)).data.creadoPor == request.auth.uid;
    }

    function jugadorVigenteParaInvitacion(academiaId, jugadorUid) {
      let miembro = get(/databases/$(database)/documents/academias/$(academiaId)/miembros/$(jugadorUid)).data;
      return get(/databases/$(database)/documents/academias/$(academiaId)).data.activa == true
        && miembro.uid == jugadorUid && miembro.academiaId == academiaId
        && miembro.rol == 'JUG' && miembro.activo == true
        && cuentaHabilitadaConRol(jugadorUid, 'JUG');
    }

    function datosSolicitudApoderadoValidos(s, invitacion) {
      let campos = ['academiaId', 'jugadorUid', 'apoderadoUid', 'nombreApoderado',
        'relacionDeclarada', 'estado', 'fechaCreacion'];
      return s.keys().hasAll(campos) && s.keys().hasOnly(campos)
        && s.academiaId == invitacion.academiaId
        && s.jugadorUid == invitacion.jugadorUid
        && s.apoderadoUid == invitacion.apoderadoUid
        && s.apoderadoUid == request.auth.uid
        && s.nombreApoderado is string
        && s.nombreApoderado.size() >= 2 && s.nombreApoderado.size() <= 100
        && s.nombreApoderado == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nombre
        && s.relacionDeclarada in ['MADRE', 'PADRE', 'APODERADO_AUTORIZADO']
        && s.estado == 'PENDIENTE' && s.fechaCreacion == request.time;
    }

    match /invitacionesApoderado/{codigo} {
      // El administrador necesita leer un código aún inexistente para crear
      // la invitación mediante una transacción con reintentos seguros.
      allow get: if (esAdministradorActivo()
          && (!exists(/databases/$(database)/documents/invitacionesApoderado/$(codigo))
            || administraAcademiaDeInvitacion(resource.data.academiaId)))
        || (request.auth != null && resource.data.apoderadoUid == request.auth.uid
          && cuentaHabilitadaConRol(request.auth.uid, 'PAD'));

      allow create: if request.auth != null
        && codigo.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
        && request.resource.data.keys().hasAll([
          'academiaId', 'jugadorUid', 'apoderadoUid', 'creadoPor',
          'estado', 'fechaCreacion', 'fechaVencimiento'
        ])
        && request.resource.data.keys().hasOnly([
          'academiaId', 'jugadorUid', 'apoderadoUid', 'creadoPor',
          'estado', 'fechaCreacion', 'fechaVencimiento'
        ])
        && request.resource.data.academiaId is string
        && request.resource.data.jugadorUid is string
        && request.resource.data.apoderadoUid is string
        && request.resource.data.jugadorUid != request.resource.data.apoderadoUid
        && administraAcademiaDeInvitacion(request.resource.data.academiaId)
        && jugadorVigenteParaInvitacion(request.resource.data.academiaId, request.resource.data.jugadorUid)
        && cuentaHabilitadaConRol(request.resource.data.apoderadoUid, 'PAD')
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'DISPONIBLE'
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.fechaVencimiento is timestamp
        && request.resource.data.fechaVencimiento > request.time
        && request.resource.data.fechaVencimiento <= request.time + duration.value(48, 'h');

      function consumoValido() {
        let rutaSolicitud = /databases/$(database)/documents/solicitudesApoderado/$(codigo);
        let s = getAfter(rutaSolicitud).data;
        return request.auth != null
          && resource.data.apoderadoUid == request.auth.uid
          && cuentaHabilitadaConRol(request.auth.uid, 'PAD')
          && jugadorVigenteParaInvitacion(resource.data.academiaId, resource.data.jugadorUid)
          && resource.data.estado == 'DISPONIBLE'
          && resource.data.fechaVencimiento > request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'solicitudId', 'utilizadaPor', 'fechaUso'])
          && request.resource.data.estado == 'UTILIZADA'
          && request.resource.data.solicitudId == codigo
          && request.resource.data.utilizadaPor == request.auth.uid
          && request.resource.data.fechaUso == request.time
          && !exists(rutaSolicitud)
          && datosSolicitudApoderadoValidos(s, resource.data);
      }
      function anulacionValida() {
        return administraAcademiaDeInvitacion(resource.data.academiaId)
          && resource.data.estado == 'DISPONIBLE'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'revocadoPor', 'fechaRevocacion'])
          && request.resource.data.estado == 'REVOCADA'
          && request.resource.data.revocadoPor == request.auth.uid
          && request.resource.data.fechaRevocacion == request.time;
      }
      allow update: if consumoValido() || anulacionValida();
      allow list, delete: if false;
    }

    match /solicitudesApoderado/{codigo} {
      function invitacionOriginal() {
        return get(/databases/$(database)/documents/invitacionesApoderado/$(codigo)).data;
      }
      // Permite consultar una solicitud aún inexistente a su destinatario.
      allow get: if request.auth != null
        && ((invitacionOriginal().apoderadoUid == request.auth.uid
              && cuentaHabilitadaConRol(request.auth.uid, 'PAD'))
            || administraAcademiaDeInvitacion(invitacionOriginal().academiaId));

      function creacionConConsumo() {
        let rutaInvitacion = /databases/$(database)/documents/invitacionesApoderado/$(codigo);
        let antes = get(rutaInvitacion).data;
        let despues = getAfter(rutaInvitacion).data;
        return request.auth != null
          && cuentaHabilitadaConRol(request.auth.uid, 'PAD')
          && antes.apoderadoUid == request.auth.uid
          && antes.estado == 'DISPONIBLE' && antes.fechaVencimiento > request.time
          && jugadorVigenteParaInvitacion(antes.academiaId, antes.jugadorUid)
          && datosSolicitudApoderadoValidos(request.resource.data, antes)
          && despues.estado == 'UTILIZADA' && despues.solicitudId == codigo
          && despues.utilizadaPor == request.auth.uid && despues.fechaUso == request.time
          && despues.academiaId == antes.academiaId
          && despues.jugadorUid == antes.jugadorUid
          && despues.apoderadoUid == antes.apoderadoUid;
      }
      allow create: if creacionConConsumo();
      // Las decisiones del administrador se validan en el bloque de revisión inferior.
      allow list, update, delete: if false;
    }


    // La solicitud conserva la auditoría; el vínculo identifica la autorización vigente.
    function rutaVinculoApoderado(s) {
      return /databases/$(database)/documents/academias/$(s.academiaId)/vinculosApoderados/$(s.jugadorUid)/apoderados/$(s.apoderadoUid);
    }

    function datosVinculoAprobado(v, s, codigo) {
      let campos = ['academiaId', 'jugadorUid', 'apoderadoUid', 'solicitudId',
        'relacionDeclarada', 'activo', 'aprobadoPor', 'fechaAprobacion',
        'nombreJugador', 'nombreAcademia'];
      return v.keys().hasAll(campos) && v.keys().hasOnly(campos)
        && v.academiaId == s.academiaId && v.jugadorUid == s.jugadorUid
        && v.apoderadoUid == s.apoderadoUid && v.solicitudId == codigo
        && v.relacionDeclarada == s.relacionDeclarada && v.activo == true
        && v.aprobadoPor == request.auth.uid && v.fechaAprobacion == request.time
        // Solo nombres ya visibles en la academia; no se copia el perfil privado.
        && v.nombreJugador == get(/databases/$(database)/documents/academias/$(s.academiaId)/solicitudesVinculacion/$(s.jugadorUid)).data.nombreSolicitante
        && v.nombreAcademia == get(/databases/$(database)/documents/academias/$(s.academiaId)).data.nombre;
    }

    match /solicitudesApoderado/{codigo} {
      // La consulta debe filtrar academiaId (administrador) o apoderadoUid (apoderado).
      allow list: if administraAcademiaDeInvitacion(resource.data.academiaId)
        || (request.auth != null && resource.data.apoderadoUid == request.auth.uid
          && cuentaHabilitadaConRol(request.auth.uid, 'PAD'));

      function revisionInicialValida() {
        return resource.data.estado == 'PENDIENTE'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'revisadoPor', 'fechaRevision'])
          && request.resource.data.revisadoPor == request.auth.uid
          && request.resource.data.fechaRevision == request.time;
      }

      function aprobacionAtomica() {
        let ruta = rutaVinculoApoderado(resource.data);
        return revisionInicialValida() && request.resource.data.estado == 'APROBADA'
          && jugadorVigenteParaInvitacion(resource.data.academiaId, resource.data.jugadorUid)
          && cuentaHabilitadaConRol(resource.data.apoderadoUid, 'PAD')
          && (!exists(ruta) || get(ruta).data.activo == false)
          && datosVinculoAprobado(getAfter(ruta).data, resource.data, codigo);
      }

      function revocacionAtomica() {
        let ruta = rutaVinculoApoderado(resource.data);
        let antes = get(ruta).data;
        let despues = getAfter(ruta).data;
        return resource.data.estado == 'APROBADA' && request.resource.data.estado == 'REVOCADA'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'revocadoPor', 'fechaRevocacion'])
          && request.resource.data.revocadoPor == request.auth.uid
          && request.resource.data.fechaRevocacion == request.time
          && antes.activo == true && antes.solicitudId == codigo
          && despues.activo == false && despues.solicitudId == codigo
          && despues.revocadoPor == request.auth.uid && despues.fechaRevocacion == request.time;
      }

      allow update: if administraAcademiaDeInvitacion(resource.data.academiaId)
        && ((revisionInicialValida() && request.resource.data.estado == 'RECHAZADA')
          || aprobacionAtomica() || revocacionAtomica());
    }

    match /academias/{academiaId}/vinculosApoderados/{jugadorUid}/apoderados/{apoderadoUid} {
      allow get: if administraAcademiaDeInvitacion(academiaId)
        || (esPropietario(apoderadoUid) && cuentaHabilitadaConRol(apoderadoUid, 'PAD'));

      function aprobacionDesdeSolicitud() {
        let nuevo = request.resource.data;
        let ruta = /databases/$(database)/documents/solicitudesApoderado/$(nuevo.solicitudId);
        let antes = get(ruta).data;
        let despues = getAfter(ruta).data;
        return nuevo.academiaId == academiaId && nuevo.jugadorUid == jugadorUid
          && nuevo.apoderadoUid == apoderadoUid && jugadorUid != apoderadoUid
          && antes.estado == 'PENDIENTE' && despues.estado == 'APROBADA'
          && despues.revisadoPor == request.auth.uid && despues.fechaRevision == request.time
          && datosVinculoAprobado(nuevo, antes, nuevo.solicitudId)
          && jugadorVigenteParaInvitacion(academiaId, jugadorUid)
          && cuentaHabilitadaConRol(apoderadoUid, 'PAD');
      }

      function revocacionDesdeSolicitud() {
        let ruta = /databases/$(database)/documents/solicitudesApoderado/$(resource.data.solicitudId);
        let antes = get(ruta).data;
        let despues = getAfter(ruta).data;
        return resource.data.activo == true && request.resource.data.activo == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['activo', 'revocadoPor', 'fechaRevocacion'])
          && request.resource.data.revocadoPor == request.auth.uid
          && request.resource.data.fechaRevocacion == request.time
          && antes.academiaId == academiaId && antes.jugadorUid == jugadorUid
          && antes.apoderadoUid == apoderadoUid
          && antes.estado == 'APROBADA' && despues.estado == 'REVOCADA'
          && despues.revocadoPor == request.auth.uid && despues.fechaRevocacion == request.time;
      }

      allow create: if administraAcademiaDeInvitacion(academiaId) && aprobacionDesdeSolicitud();
      allow update: if administraAcademiaDeInvitacion(academiaId)
        && ((resource.data.activo == false && aprobacionDesdeSolicitud()) || revocacionDesdeSolicitud());
      allow list, delete: if false;
    }


    // El resto de las rutas permanece sin acceso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}