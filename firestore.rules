rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esPropietario(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function esAdministradorActivo() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.rol == 'ADM'
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.estado == 'ACTIVO';
    }

    match /{document=**} {
      allow read, write: if false;
    }
    match /academias/{academiaId} {

      function nombreValido() {
        return request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2
          && request.resource.data.nombre.size() <= 100;
      }

      // En esta primera versión, cada administrador gestiona
      // únicamente las academias que creó.
      allow get, list: if esAdministradorActivo()
        && resource.data.creadoPor == request.auth.uid;

      allow create: if esAdministradorActivo()
        && request.resource.data.keys().hasAll([
          'nombre',
          'activa',
          'creadoPor',
          'actualizadoPor',
          'fechaCreacion',
          'fechaActualizacion'
        ])
        && request.resource.data.keys().hasOnly([
          'nombre',
          'activa',
          'creadoPor',
          'actualizadoPor',
          'fechaCreacion',
          'fechaActualizacion'
        ])
        && nombreValido()
        && request.resource.data.activa == true
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.fechaActualizacion == request.time;

      allow update: if esAdministradorActivo()
        && resource.data.creadoPor == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'nombre',
              'activa',
              'actualizadoPor',
              'fechaActualizacion'
            ])
        && nombreValido()
        && request.resource.data.activa is bool
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.fechaActualizacion == request.time;

      allow delete: if false;

      match /equipos/{equipoId} {

        function administraAcademia() {
          return esAdministradorActivo()
            && get(
              /databases/$(database)/documents/academias/$(academiaId)
            ).data.creadoPor == request.auth.uid;
        }

        function academiaHabilitada() {
          return get(
            /databases/$(database)/documents/academias/$(academiaId)
          ).data.activa == true;
        }

        function categoriaHabilitada() {
          let categoriaId = request.resource.data.categoriaId;

          return categoriaId is string
            && categoriaId.matches('^[A-Za-z0-9_-]{1,128}$')
            && exists(
              /databases/$(database)/documents/academias/$(academiaId)/categorias/$(categoriaId)
            )
            && get(
              /databases/$(database)/documents/academias/$(academiaId)/categorias/$(categoriaId)
            ).data.activa == true;
        }

        function nombreEquipoValido() {
          let nombre = request.resource.data.nombre;

          return nombre is string
            && nombre.size() >= 2
            && nombre.size() <= 60
            && nombre.matches("^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9 .'-]+$")
            && nombre == nombre.trim().replace(' +', ' ');
        }

        allow get, list: if administraAcademia();

        allow create: if administraAcademia()
          && academiaHabilitada()
          && request.resource.data.keys().hasAll([
            'academiaId',
            'categoriaId',
            'nombre',
            'activo',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion',
            'solicitudId'
          ])
          && request.resource.data.keys().hasOnly([
            'academiaId',
            'categoriaId',
            'nombre',
            'activo',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion',
            'solicitudId'
          ])
          && request.resource.data.academiaId == academiaId
          && categoriaHabilitada()
          && nombreEquipoValido()
          && equipoId == (
            request.resource.data.categoriaId
            + '_'
            + request.resource.data.nombre.lower()
          )
          && request.resource.data.activo == true
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaCreacion == request.time
          && request.resource.data.fechaActualizacion == request.time
          && request.resource.data.solicitudId is string
          && request.resource.data.solicitudId.matches(
            '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$'
          );

        // Por ahora solo permite activar o desactivar el equipo.
        allow update: if administraAcademia()
          && academiaHabilitada()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'activo',
                'actualizadoPor',
                'fechaActualizacion'
              ])
          && request.resource.data.activo is bool
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaActualizacion == request.time;

        allow delete: if false;
      }

      match /categorias/{categoriaId} {

        function puedeGestionarAcademia() {
          return esAdministradorActivo()
            && get(
              /databases/$(database)/documents/academias/$(academiaId)
            ).data.creadoPor == request.auth.uid;
        }

        function academiaActiva() {
          return get(
            /databases/$(database)/documents/academias/$(academiaId)
          ).data.activa == true;
        }

        function nombreCategoriaValido() {
          return request.resource.data.nombre is string
            && request.resource.data.nombre.size() >= 2
            && request.resource.data.nombre.size() <= 60;
        }

        allow get, list: if puedeGestionarAcademia();

        allow create: if puedeGestionarAcademia()
          && academiaActiva()
          && request.resource.data.keys().hasAll([
            'academiaId',
            'nombre',
            'activa',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion'
          ])
          && request.resource.data.keys().hasOnly([
            'academiaId',
            'nombre',
            'activa',
            'creadoPor',
            'actualizadoPor',
            'fechaCreacion',
            'fechaActualizacion'
          ])
          && request.resource.data.academiaId == academiaId
          && nombreCategoriaValido()
          && request.resource.data.activa == true
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaCreacion == request.time
          && request.resource.data.fechaActualizacion == request.time;

        allow update: if puedeGestionarAcademia()
          && academiaActiva()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'nombre',
                'activa',
                'actualizadoPor',
                'fechaActualizacion'
              ])
          && nombreCategoriaValido()
          && request.resource.data.activa is bool
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.fechaActualizacion == request.time;

        allow delete: if false;
      }
    }

    match /users/{uid} {
      allow get: if esPropietario(uid);

      allow create: if esPropietario(uid)
        && request.resource.data.keys().hasAll([
          'uid',
          'nombre',
          'correo',
          'rol',
          'fechaNacimiento',
          'edadVerificada',
          'estado',
          'fechaCreacion',
          'aceptoTerminos'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'nombre',
          'correo',
          'rol',
          'fechaNacimiento',
          'edadVerificada',
          'estado',
          'fechaCreacion',
          'aceptoTerminos'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.rol in ['JUG', 'PAD', 'DT']
        && request.resource.data.fechaNacimiento is string
        && request.resource.data.fechaNacimiento.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.edadVerificada == false
        && request.resource.data.estado == 'PENDIENTE_VINCULACION'
        && request.resource.data.fechaCreacion == request.time
        && request.resource.data.aceptoTerminos == true;

      allow update: if esPropietario(uid)
        && resource.data.estado == 'PENDIENTE_VINCULACION'
        && !('fechaNacimiento' in resource.data)
        && resource.data.get('edadVerificada', false) == false
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['fechaNacimiento', 'edadVerificada'])
        && request.resource.data.keys().hasAll([
          'fechaNacimiento', 'edadVerificada'
        ])
        && request.resource.data.fechaNacimiento is string
        && request.resource.data.fechaNacimiento.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.edadVerificada == false;

      allow list, delete: if false;
    }


  }
}